variant: openshift
version: 4.20.0
metadata:
  name: 99-master-openperouter
  labels:
    machineconfiguration.openshift.io/role: master
storage:
  files:
    # --- Rawconfig scripts (mode 0755) ---
    - path: /usr/local/bin/generate-config.sh
      mode: 0755
      overwrite: true
      contents:
        local: common/generate-config.sh
    - path: /usr/local/bin/can_start.sh
      mode: 0755
      overwrite: true
      contents:
        local: quadlets/can_start.sh
    - path: /var/lib/openperouter/can_start.sh
      mode: 0755
      overwrite: true
      contents:
        local: quadlets/can_start.sh
    # --- Empty openpe_config.yaml (controller needs it to exist) ---
    - path: /var/lib/openperouter/configs/openpe_config.yaml
      mode: 0644
      overwrite: true
      contents:
        inline: ""
    # --- Rawconfig templates and env (mode 0644) ---
    - path: /etc/openperouter/templates/openpe_master.yaml
      mode: 0644
      overwrite: true
      contents:
        local: config/openpe_master.yaml
    - path: /etc/openperouter/templates/openpe_worker.yaml
      mode: 0644
      overwrite: true
      contents:
        local: config/openpe_worker.yaml
    # --- FRR daemons file (enables isisd for ISIS + SRv6) ---
    - path: /etc/perouter/daemons
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/daemons
    - path: /etc/systemd/network/10-underlayvf.link
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Match]
          OriginalName=ens1f0v0 eno12399v0

          [Link]
          AlternativeName=underlayvf
    - path: /etc/systemd/network/10-trunkvf.link
      mode: 0644
      overwrite: true
      contents:
        inline: |
          [Match]
          OriginalName=ens1f0v1 eno12399v1

          [Link]
          AlternativeName=trunkvf
    # --- Node index configuration ---
    - path: /var/lib/openperouter/node-config.yaml
      mode: 0644
      overwrite: true
      contents:
        local: config/node-config.yaml
    # --- Shared installer patching script ---
    - path: /usr/local/bin/patch-installer-config.sh
      mode: 0755
      overwrite: true
      contents:
        local: common/patch-installer-config.sh
    - path: /etc/kubernetes/manifests/workload-pod.yaml
      mode: 0644
      overwrite: true
      contents:
        local: config/workload-pod.yaml
    # --- Quadlet files ---
    - path: /etc/containers/systemd/controllerpod.pod
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/controllerpod.pod
    - path: /etc/containers/systemd/controller.container
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/controller.container
    - path: /etc/containers/systemd/routerpod.pod
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/routerpod.pod
    - path: /etc/containers/systemd/frr.container
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/frr.container
    - path: /etc/containers/systemd/reloader.container
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/reloader.container
    - path: /etc/containers/systemd/grout.container
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/grout.container
    - path: /etc/containers/systemd/frr-sockets.volume
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/frr-sockets.volume
systemd:
  units:
    # --- Quadlet services ---
    - name: controllerpod.service
      enabled: true
    - name: controller.service
      enabled: true
    - name: routerpod.service
      enabled: true
    - name: frr.service
      enabled: true
    - name: reloader.service
      enabled: true
    - name: grout.service
      enabled: true
    - name: frr-sockets.service
      enabled: true
    - name: grout.slice
      enabled: true
      contents: |
        [Slice]
        AllowedCPUs=0-6

        [Install]
        WantedBy=default.target
    - name: perouter-restart-pods.service
      enabled: false
      contents: |
        [Unit]
        Description=Restart all OpenPERouter pods

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/systemctl restart controllerpod-pod.service routerpod-pod.service
    - name: load-vfio-pci.service
      enabled: true
      contents: |
        [Unit]
        Description=Load vfio-pci kernel module
        After=local-fs-pre.target
        Wants=local-fs-pre.target

        [Service]
        Type=oneshot
        ExecStart=modprobe vfio-pci
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target
    # --- Rawconfig systemd services ---
    - name: generate-config.service
      enabled: true
      contents: |
        [Unit]
        Description=OpenPERouter Configuration Generator
        Documentation=https://github.com/openperouter/openperouter
        After=network-online.target routerpod-pod.service frr.service
        Requires=routerpod-pod.service
        Wants=network-online.target

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        User=root
        Group=root
        ExecStartPre=/usr/local/bin/can_start.sh
        ExecStart=/usr/local/bin/generate-config.sh
        StandardOutput=journal
        StandardError=journal
        SyslogIdentifier=generate-config
        TimeoutStartSec=60
        TimeoutStopSec=10

        [Install]
        WantedBy=multi-user.target
    # --- Shared installer patching service ---
    - name: enable-virtual-interfaces.service
      enabled: true
      contents: |
        [Unit]
        Description=Patch Assisted Service installer config for openperouter
        Before=assisted-service-pod.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/patch-installer-config.sh
        Restart=on-failure
        RestartSec=2
        RemainAfterExit=yes

        [Install]
        WantedBy=assisted-service-pod.service

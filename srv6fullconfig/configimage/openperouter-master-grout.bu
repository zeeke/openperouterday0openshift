variant: openshift
version: 4.20.0
metadata:
  name: 98-master-grout
  labels:
    machineconfiguration.openshift.io/role: master
storage:
  files:
    - path: /etc/containers/systemd/grout.container
      mode: 0644
      overwrite: true
      contents:
        local: quadlets/grout.container
    - path: /etc/kubernetes/manifests/pod-grout-reservation-master.yaml
      mode: 0644
      overwrite: true
      contents:
        local: config/pod-grout-reservation-master.yaml
systemd:
  units:
    - name: grout.service
      enabled: true
    - name: perouter-restart-pods.service
      enabled: false
      contents: |
        [Unit]
        Description=Restart all OpenPERouter pods

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/systemctl restart controllerpod-pod.service routerpod-pod.service
    - name: grout.slice
      enabled: true
      contents: |
        [Slice]
        AllowedCPUs=0-6

        [Install]
        WantedBy=default.target

    - name: load-vfio-pci.service
      enabled: true
      contents: |
        [Unit]
        Description=Load vfio-pci kernel module
        After=local-fs-pre.target
        Wants=local-fs-pre.target

        [Service]
        Type=oneshot
        ExecStart=modprobe vfio-pci
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

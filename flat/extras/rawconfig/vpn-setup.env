# OpenPERouter VPN Setup Environment Variables
# Defaults tuned for the dev-scripts environment (flat / ISIS routing mode)
#
# Location on node: /etc/openperouter/vpn-setup.env

# ============================================================================
# Underlay Configuration (setup-underlay.service)
# ============================================================================

# Physical NIC to move into FRR namespace for switch uplink
UNDERLAY_NIC=ens1f0v0

# Trunk VF to move into FRR namespace (VLAN sub-interface connects host to FRR ns)
TRUNK_NIC=ens1f0v1

# ISIS area for NET address derivation
ISIS_AREA=49.0001

# Timeout (in seconds) to wait for FRR container to become ready
FRR_READY_TIMEOUT=60

# Timeout (in seconds) to wait for VF2/br-ex to acquire an IP address
HOST_IP_TIMEOUT=120

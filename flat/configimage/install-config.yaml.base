apiVersion: v1
baseDomain: example.com
cpuPartitioningMode: AllNodes
compute:
- hyperthreading: Enabled
  name: worker
  replicas: 0
  architecture: null
controlPlane:
  architecture: null
  hyperthreading: Enabled
  name: master
  replicas: 1
fips: false
metadata:
  name: sno-lab
  namespace: cluster0
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  - cidr: fd01::/48
    hostPrefix: 64
  machineNetwork:
  - cidr: 192.168.110.0/24
  - cidr: fd00:110::/64
  serviceNetwork:
  - 172.30.0.0/16
  - fd02::/112
  networkType: OVNKubernetes
platform:
  none: {}
pullSecret: REPLACE_ME
sshKey: REPLACE_ME

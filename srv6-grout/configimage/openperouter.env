# openperouter.env - Central configuration for OpenPERouter deployment
#
# This file and agent-config.yaml are the only files that need to be
# tuned for individual deployments. All derived addressing (Router ID,
# loopbacks, SRv6 locators, ISIS NET) is computed at boot time by
# perouter-host-dispatch.sh from the host VF's last octet and the
# format strings below.

# ============================================================================
# Grout DPDK dataplane
# ============================================================================

# Path to the grout API socket (used by grcli)
GROUT_SOCK_PATH=/run/grout/grout.sock

# Number of CPU cores dedicated to grout datapath threads
GROUT_CPUS=4

# Amount of 1G hugepages reserved for grout (Kubernetes resource request)
GROUT_HUGEPAGES_1G=8Gi

# Maximum number of DPDK sockets (affects memory allocation)
GROUT_SOCKET_LIMIT=8192

# ============================================================================
# ISIS underlay
# ============================================================================

# ISIS area prefix. Nodes derive their NET from this + node index.
# Example: area 49.0001, node index 2 -> NET 49.0001.0000.0000.0002.00
ISIS_AREA=49.0001

# ============================================================================
# BGP / SRv6 L3VPN
# ============================================================================

# iBGP AS number (all nodes share the same AS)
BGP_AS=65500

# Node index of the EVPN route reflector. The node whose host VF last
# octet matches this value becomes the RR; all others are clients.
RR_NODE_IDX=2

# IPv6 loopback of the SRv6 gateway (external peer). All nodes peer
# with this address for ipv4/ipv6 VPN (SRv6 L3VPN north-south).
SRV6_GATEWAY=fc00:0:20::1

# IPv6 prefix for dynamic EVPN client peers (bgp listen range on RR)
EVPN_LISTEN_RANGE=fc00::/16

# ============================================================================
# Address format strings
# ============================================================================
# These printf-style patterns are expanded at boot by
# perouter-host-dispatch.sh using the host VF's last octet as %d or %x.
# They define the per-node addressing scheme for the SRv6/VXLAN fabric.

# Router ID and VTEP source (IPv4, used as VXLAN local VTEP)
# Example: node index 2 -> 10.0.0.2
ROUTER_ID_FMT=10.0.0.%d

# IPv6 loopback for BGP peering (update-source)
# Example: node index 2 -> fc00:0:2::1
LOOPBACK_V6_FMT=fc00:0:%x::1

# SRv6 encapsulation source address
# Example: node index 2 -> fd00:2::1
SRV6_SOURCE_FMT=fd00:%x::1

# SRv6 locator block prefix (node ID is appended as :N::/48)
# Example: node index 2 -> fd00:2
SRV6_PREFIX_FMT=fd00:%x

# ============================================================================
# L2VPN / EVPN overlay
# ============================================================================

# VRF name for the L3VPN + L2VPN overlay
VRF_NAME=red

# L2VPN VXLAN Network Identifier -- L2 bridging between nodes
L2_VNI=210

# Anycast gateway IP on the L2 bridge (same on all nodes)
L2_GATEWAY_IP=192.168.110.1/24
L2_GATEWAY_IP_V6=fd00:110::1/64


# Per-node underlay addresses (point-to-point link on the ISIS interface)
# Each line: <hostname> <ipv4> <ipv6>
# Leave empty for unnumbered point-to-point links
UNDERLAY_ADDRESSES="
master-0.sno-lab.example.com 192.168.135.21/25 2600:52:7:135::21/64
master-1.sno-lab.example.com 192.168.136.22/25 2600:52:7:136::22/64
master-2.sno-lab.example.com 192.168.137.23/25 2600:52:7:137::23/64
"

# TODO: this is not good. It is used by can_start.sh to wait for the OVS migration to finish.
# We should find a better way to discover if that migration has finished.
HOST_VF=ens1f0v1

NODE_INDEXES="
master-0.sno-lab.example.com 0
master-1.sno-lab.example.com 1
master-2.sno-lab.example.com 2
"

!                                                                                                                                                                                      
frr version 10.6.1                                                                                                                                                                     
frr defaults traditional                                                                                                                                                               
hostname dell-r450-nfv2023-01.lab.eng.brq2.redhat.com                                                                                                                                  
log stdout                                                                                                                                                                             
log timestamp precision 3                                                                                                                                                              
service integrated-vtysh-config                                                                                                                                                        
!                                                                                                                                                                                      
route-map allowall permit 1                                                                                                                                                            
exit                                                                                                                                                                                   
!                                                                                                                                                                                      
debug zebra dplane dpdk                                                                                                                                                                
!                                                                                                                                                                                      
vrf main                                                                                                                                                                               
exit-vrf                                                                                                                                                                               
!                                                                                                                                                                                      
vrf red                                                                                                                                                                                
exit-vrf                                                                                                                                                                               
!                                                                                                                                                                                      
interface underlay0                                                                                                                                                                    
 ip address 10.0.0.2/32                                                                                                                                                                
 ip router isis PE                                                                                                                                                                     
 ipv6 address fc00:0:2::1/128                                                                                                                                                          
 ipv6 address fc00:100::2/128                                                                                                                                                          
 ipv6 address fd00:2::1/128                                                                                                                                                            
 ipv6 router isis PE                                                                                                                                                                   
 isis circuit-type level-1                                                                                                                                                             
 isis network point-to-point                                                                                                                                                           
exit                                                                                                                                                                                   
!                                                                                                                                                                                      
router bgp 65500                                                                                                                                                                       
 bgp router-id 10.0.0.2
 bgp log-neighbor-changes
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 no bgp network import-check
 neighbor EVPN-CLIENTS peer-group
 neighbor EVPN-CLIENTS remote-as 65500
 neighbor EVPN-CLIENTS update-source fc00:0:2::1
 neighbor SRV6-GW peer-group
 neighbor SRV6-GW remote-as 65500
 neighbor SRV6-GW update-source fc00:0:2::1
 neighbor fc00:0:14::1 peer-group SRV6-GW
 bgp listen range fc00::/16 peer-group EVPN-CLIENTS
 !                                                                                                                                                                                     
 segment-routing srv6                                                                                                                                                                  
  locator MAIN                                                                                                                                                                         
  encap-behavior H_Encaps_Red                                                                                                                                                          
 exit                                                                                                                                                                                  
 !                                                                                                                                                                                     
 address-family ipv4 vpn                                                                                                                                                               
  neighbor SRV6-GW activate                                                                                                                                                            
 exit-address-family                                                                                                                                                                   
 !                                                                                                                                                                                     
 address-family ipv6 vpn                                                                                                                                                               
  neighbor SRV6-GW activate                                                                                                                                                            
 exit-address-family                                                                                                                                                                   
 !
 address-family l2vpn evpn
  neighbor EVPN-CLIENTS activate
  neighbor EVPN-CLIENTS route-reflector-client
  advertise-all-vni
  advertise-svi-ip
 exit-address-family
exit
!
router bgp 65500 vrf red
 bgp router-id 10.0.0.2
 no bgp ebgp-requires-policy
 no bgp default ipv4-unicast
 no bgp network import-check
 sid vpn per-vrf export auto
 !
 address-family ipv4 unicast
  network 192.168.110.0/24
  rd vpn export 10.0.0.2:2
  rt vpn both 65500:2
  export vpn
  import vpn
 exit-address-family
 !
 address-family ipv6 unicast
  network fd00:110::/64
  rd vpn export 10.0.0.2:2
  rt vpn both 65500:2
  export vpn
  import vpn
 exit-address-family
 !
 address-family l2vpn evpn
  advertise ipv4 unicast
  advertise ipv6 unicast
 exit-address-family
exit
!
router isis PE
 is-type level-1
 net 49.0001.0000.0000.0002.00
 lsp-timers gen-interval 2 refresh-interval 900 max-lifetime 1200
 topology ipv6-unicast
 log-adjacency-changes
 log-pdu-drops
 segment-routing srv6
  locator MAIN
 exit
exit
!
segment-routing
 srv6
  encapsulation
   source-address fd00:2::1
  exit
  locators
   locator MAIN
    prefix fd00:2::/48 block-len 32 node-len 16
    behavior usid
   exit
   !
  exit
  !
 exit
 !
exit
!
end

